{
  "name": "apartmender",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:catalog": "node tools/validate-catalog.mjs",
    "rec-demo:build": "npm --prefix experiments/rec-demo run build",
    "rec-demo:test": "npm --prefix experiments/rec-demo test",
    "rec-demo:test:browser": "npm --prefix experiments/rec-demo run test:browser",
    "test": "node --test",
    "test:public": "playwright test e2e/catalog.spec.js e2e/public-practice.spec.js e2e/public-score.spec.js e2e/notation-descriptor.spec.js --workers=1",
    "test:browser": "playwright test e2e/practice-local.spec.js --workers=1",
    "test:teacher": "playwright test e2e/teacher.spec.js e2e/teacher-notes.spec.js --workers=1",
    "test:teacher:local": "playwright test e2e/teacher-local.spec.js --workers=1",
    "test:onboarding": "playwright test e2e/onboarding.spec.js e2e/password-visibility.spec.js --workers=1",
    "test:onboarding:local": "playwright test e2e/onboarding-local.spec.js --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
